# ==============================================================================
# Elsewhere — Environment Configuration Example
# Copy this file to .env.local to configure custom credentials.
# NOTE: All keys are optional. Elsewhere works out of the box with zero setup!
# ==============================================================================

# ------------------------------------------------------------------------------
# World Pulse News API (The Guardian Open Platform)
# ------------------------------------------------------------------------------
# Free Developer Tier: 5,000 requests/day, 1 call/second.
# Licensing: Open access for non-commercial, personal, and developmental use.
# Obtain a key: https://open-platform.theguardian.com/access/
# When left empty, Elsewhere automatically connects to verified official syndicated
# feeds and curated benchmark dispatches with zero disruption.
GUARDIAN_API_KEY=your_guardian_open_platform_api_key_here

# Cache duration in seconds to respect rate limits (Default: 900s / 15 minutes)
NEWS_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# Supabase Cloud Database (Optional for profile sync across devices)
# ------------------------------------------------------------------------------
# Leave blank to use fast local storage on device
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
